{
    "name": "event-management-api",
    "description": "Event manager planning tool.",
    "version": "0.1.0",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "server": "tsx --env-file=.env src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/urvenogu/event-management-api.git"
    },
    "type": "module",
    "bugs": {
        "url": "https://github.com/urvenogu/event-management-api/issues"
    },
    "homepage": "https://github.com/urvenogu/event-management-api#readme",
    "dependencies": {
        "express": "^5.3.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.6",
        "oxlint": "^1.94.0",
        "prettier": "^3.10.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    }
}
